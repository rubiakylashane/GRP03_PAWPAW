{
  "projectType": "server",
  "setup": [
    {
      "command": "npm",
      "args": ["ci"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "database-health",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "start"],
      "env": {
        "PORT": "5057"
      },
      "url": "http://localhost:5057/api/health",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 60
    },
    {
      "name": "login-page-redirect",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "start"],
      "env": {
        "PORT": "5057"
      },
      "url": "http://localhost:5057/",
      "verificationMethod": "output-contains",
      "expected": "Welcome back",
      "timeoutSeconds": 60
    }
  ]
}
